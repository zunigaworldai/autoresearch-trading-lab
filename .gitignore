# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
worktrees/
results/
queue/

# Experimental code/artifacts
dev/

# Results file
results.tsv

# Secrets and credentials
.env
.env.*
*.pem
*.key

# Trading lab local/runtime files
experiments/latest_result.json

# Logs (blanket, preserve .gitkeep)
logs/*
!logs/.gitkeep

# Generated strategy experiment outputs
experiments/*.json
experiments/trade_logs/*.csv

# Historical raw/processed market data
data/raw/
data/processed/
data/processed_standard/

# Large data files (anywhere in the repo)
*.csv
*.parquet
*.db
*.sqlite
*.sqlite3
*.hdf5
*.h5
!logs/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/.gitkeep

# Historical backtest generated outputs
outputs/backtests/

# Research generated outputs
outputs/research/
